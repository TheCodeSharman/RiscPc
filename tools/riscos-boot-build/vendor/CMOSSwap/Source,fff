REM >CMOSSwap
REM Per-OS CMOS save/restore for the universal !Boot per-OS cache.
REM Called from BootRun (see build.py patch_bootrun_per_os_bootcfg) on a ROM
REM swap, so each RISC OS version keeps its own CMOS (the module-unplug mask is
REM position-keyed and misfires across ROMs otherwise -- e.g. 4.02's Freeway/
REM ShareFS unplug bits land on 3.7's Net/BootNet). Reads two system variables:
REM   CMOSSwap$Save - file to write the OUTGOING OS's CMOS to, or "" to skip
REM   CMOSSwap$Load - file to restore THIS OS's CMOS from; if absent, seed it
REM Format = 240-byte type &FF2 image (CMOS locations 0..239), identical to
REM !SaveCMOS and the hooks' ResetCMOS. Restore skips loc 0 (as !SaveCMOS does);
REM locations 0..239 exclude the RTC clock, so the time is never disturbed.
DIM cmos% 240, var% 256
save$=FNvar("CMOSSwap$Save")
load$=FNvar("CMOSSwap$Load")
IF save$<>"" THEN PROCsave(save$)
IF load$<>"" THEN PROCload(load$)
END
:
DEFPROCsave(f$)
LOCAL i%
FOR i%=0 TO 239
SYS "OS_Byte",161,i% TO ,,cmos%?i%
NEXT
SYS "OS_File",10,f$,&FF2,,cmos%,cmos%+240
ENDPROC
:
DEFPROCload(f$)
LOCAL i%,t%
SYS "OS_File",17,f$ TO t%
IF t%=0 THEN PROCsave(f$):ENDPROC
SYS "OS_File",255,f$,cmos%,0
FOR i%=1 TO 239
SYS "OS_Byte",162,i%,cmos%?i%
NEXT
ENDPROC
:
DEFFNvar(n$)
LOCAL l%
SYS "XOS_ReadVarVal",n$,var%,256,0,0 TO ,,l%
IF l%<=0 THEN =""
var%?l%=13
=$var%
