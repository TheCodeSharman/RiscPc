# RISC PC (main PCB drawing 1208,000) — headphone amplifier.
#
# The board has no public schematic; this is the map found by probing.
# ../../README.md is the authority — this is a transcription of it.
#
# Pin numbers are the real ones on the device, so this can be checked
# straight against a datasheet. There is no layout in this file; positions
# are worked out by layout.py from the connectivity alone.

# ---- nets -----------------------------------------------------------------
# Naming a net makes it a join point: everything wired to it is one node.

net GND
net 5V
net 12V
net -12V
net 12V_RAW
net -12V_RAW
net VREF
net IREF

# The DAC's digital side. VIDC20's own pin numbers were never recorded, so
# these stop at named nets rather than inventing a part.
net I2S_BCK
net I2S_WS
net I2S_DATA

# ---- parts ----------------------------------------------------------------
# part <type>:<ref>.  A trailing ? on the type means never confirmed on the
# board — it draws grey and is flagged in the netlist.

part TDA1545A:DAC

# TL074 #1 — one quad package, but drawn as its four sections, which is how
# a schematic shows a multi-section device. Pins 4 and 11 are the package's
# single supply pair, shared by all four sections; they are declared once,
# on U1A, rather than repeated.
part TL074:U1A
part TL074:U1B
part TL074:U1C
part TL074:U1D

part BC849C:Q4
part BC849C:Q1

# Right channel.
part 2k1:Riv_R
part Cf?:Cf_R
part 47u16V:Cac_R
part 47k:Rin_R
part 15k:Rbias_R
part 47k:Rfb_R
part 340R:Rpull_R
part 33R:Rs1_R
part 3R3:Rs2_R

# Left channel — the mirror.
part 2k1:Riv_L
part Cf?:Cf_L
part 47u16V:Cac_L
part 47k:Rin_L
part 15k:Rbias_L
part 47k:Rfb_L
part 340R:Rpull_L
part 33R:Rs1_L
part 3R3:Rs2_L

# ±12 V op-amp feed.
part 2u2:L13
part 2u2:L14
part reservoir?:Cres_P
part reservoir?:Cres_N

# Off-board.
part jack:SK12_R
part jack:SK12_L
part jack:SK12_SLEEVE

# ---- connections ----------------------------------------------------------
# <part>@<pin> -> <part>@<pin>, or -> a named net. Chains are allowed.

# TDA1545A: 1 BCK, 2 WS, 3 DATA, 4 GND, 5 VDD, 6 IOL, 7 IREF, 8 IOR.
DAC@1 -> I2S_BCK
DAC@2 -> I2S_WS
DAC@3 -> I2S_DATA
DAC@4 -> GND
DAC@5 -> 5V
DAC@7 -> IREF

# TL074 package supply, shared by all four sections.
U1A@4 -> 12V
U1A@11 -> -12V

# ---- right channel --------------------------------------------------------
# Section A, I/V converter: out 1, -in 2, +in 3.
# The DAC output is a current; it lands on the summing node.
DAC@8 -> U1A@2
U1A@2 -> Riv_R@1
U1A@2 -> Cf_R@1
U1A@1 -> Riv_R@2
U1A@1 -> Cf_R@2
U1A@3 -> VREF

# AC coupling into the driver. Cac +ve faces the I/V output.
U1A@1 -> Cac_R@1
Cac_R@2 -> Rin_R@1

# Section D, driver: out 14, -in 13, +in 12.
# +in is biased to 0 V through 15k — not a hard ground.
Rin_R@2 -> U1D@13
U1D@12 -> Rbias_R@1
Rbias_R@2 -> GND
U1D@14 -> Q4@b

# Output follower. Feedback is taken from the EMITTER, so the transistor
# sits inside the loop — which is why op-amp out <-> -in reads OPEN.
Q4@c -> 5V
Q4@e -> Rfb_R@1
Rfb_R@2 -> U1D@13
Q4@e -> Rpull_R@1
Rpull_R@2 -> -12V

# DC-coupled to the phones — no series output capacitor.
Q4@e -> Rs1_R@1
Rs1_R@2 -> Rs2_R@1
Rs2_R@2 -> SK12_R@1

# ---- left channel ---------------------------------------------------------
# Section B, I/V converter: out 7, -in 6, +in 5.
DAC@6 -> U1B@6
U1B@6 -> Riv_L@1
U1B@6 -> Cf_L@1
U1B@7 -> Riv_L@2
U1B@7 -> Cf_L@2
U1B@5 -> VREF

U1B@7 -> Cac_L@1
Cac_L@2 -> Rin_L@1

# Section C, driver: out 8, -in 9, +in 10.
Rin_L@2 -> U1C@9
U1C@10 -> Rbias_L@1
Rbias_L@2 -> GND
U1C@8 -> Q1@b

Q1@c -> 5V
Q1@e -> Rfb_L@1
Rfb_L@2 -> U1C@9
Q1@e -> Rpull_L@1
Rpull_L@2 -> -12V

Q1@e -> Rs1_L@1
Rs1_L@2 -> Rs2_L@1
Rs2_L@2 -> SK12_L@1

# ---- supply feed ----------------------------------------------------------
12V_RAW -> L13@1
L13@2 -> 12V
12V -> Cres_P@1
Cres_P@2 -> GND

-12V_RAW -> L14@1
L14@2 -> -12V
-12V -> Cres_N@1
Cres_N@2 -> GND

SK12_SLEEVE@1 -> GND

# ---- not modelled ---------------------------------------------------------
# op-amp #2 (speaker path) and the LM386 output network are deliberately
# unmapped — see "Remaining" in ../../README.md.
