.DS_Store

# Python bytecode. The trailing /* form ignored the contents but left the
# directory itself untracked, so it still showed up as a pending change.
**/__pycache__/
*.pyc

# Node deps — ignored per-project too, repeated here so a new one is covered.
**/node_modules/

# VSCode "Local History" extension writes these into the workspace.
**/.history/

# direnv / nix dev shell (local cache)
.direnv/

# MCP server config — machine-specific absolute paths (copy from rpcemu's mcp.json.example)
.mcp.json

# KiCad
**/*-backups/
**/fp-info-cache
**/*.lck
**/_autosave-*
# Large derived LA exports (regenerate from .dsl via DSView + ds-view/stitch_full.py)
# Two exceed GitHub's 100 MB per-file limit; all three are reproducible.
ds-view/sa110-bad-full.csv
ds-view/sa110-bad-lowslice.csv
ds-view/sa110-bad-highslice.csv

# uv venv for the build123d models (mechanical/); rebuild with `uv sync`.
mechanical/.venv/
